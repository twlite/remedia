{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "discord-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint src --deny-warnings",
    "deploy": "node --env-file=.env --import tsx src/util/deploy.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "prestart": "pnpm --filter @remedia/node build",
    "start": "node --env-file=.env --import tsx src/index.ts",
    "test": "node --import tsx --test src/voice/playback-manager.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@discordjs/core": "^2.3.0",
    "@remedia/node": "workspace:*",
    "discord.js": "^14.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.18.8",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
