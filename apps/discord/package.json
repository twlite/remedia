{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "discord-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint src --deny-warnings",
    "deploy": "tsx --env-file=.env ./src/util/deploy.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "prestart": "if [ \"${REMEDIA_MODE:-embedded}\" = \"embedded\" ]; then pnpm --filter @remedia/node build; fi; pnpm --filter @remedia/client build",
    "dev": "tsx --env-file=.env --watch src/index.ts",
    "start": "tsx --env-file=.env src/index.ts",
    "test": "tsx --test src/voice/*.test.ts src/commands/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@discordjs/core": "^2.3.0",
    "@remedia/client": "workspace:*",
    "discord.js": "^14.24.0"
  },
  "devDependencies": {
    "@remedia/node": "workspace:*",
    "@types/node": "^22.18.8",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
