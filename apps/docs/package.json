{
  "name": "docs",
  "version": "0.0.52",
  "private": true,
  "scripts": {
    "build": "pnpm --workspace-root run docs:api && node scripts/copy-installers.mjs && next build && node scripts/check-links.mjs && pnpm --workspace-root run docs:verify-export",
    "dev": "pnpm --workspace-root run docs:api && next dev",
    "typecheck": "next typegen && tsc --noEmit",
    "check:links": "node scripts/check-links.mjs"
  },
  "dependencies": {
    "cn": "^0.5.0",
    "fumadocs-core": "16.17.9",
    "fumadocs-mdx": "15.4.10",
    "fumadocs-ui": "npm:@fumadocs/base-ui@16.17.9",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
