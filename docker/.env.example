# Copy to docker/.env (never commit that file) and replace every placeholder.
#   cp .env.example .env && chmod 600 .env
#
# Compose reads this file twice: to substitute ${VARIABLES} inside compose.yaml, and
# (through `env_file`) to pass every variable below to the Remedia container. Do not put
# quotes or `$` characters in values; `openssl rand -hex 32` produces a safe secret.

# --- Secrets (passed into the container) -------------------------------------------------

# Password for the RPC account "media-bot" in config/remedia.config.json.
# Generate one with: openssl rand -hex 32
REMEDIA_RPC_PASSWORD=replace-with-a-long-random-password

# Bearer tokens for authenticated plugin hosts. Name them anything and register a host with
# `plugins install <url> --token-env NAME`; the config stores only the variable's name.
# REMEDIA_PLUGIN_TOKEN=replace-with-the-plugin-host-token

# --- Optional diagnostics (passed into the container) ------------------------------------

# Tracing filter. Defaults to "warn". For example: info, or remedia_core=debug,remedia_discord=info
# REMEDIA_LOG=info
# One-event-per-line JSON logs instead of text.
# REMEDIA_LOG_FORMAT=json

# --- Build and runtime settings (used by Compose only) -----------------------------------

# Remedia release baked into the image, without the leading "v". Pin it explicitly and
# change it deliberately to upgrade; see https://github.com/twlite/remedia/releases
REMEDIA_VERSION=0.1.0-dev.6

# Numeric user and group the server runs as. They must be able to write ./config.
# The image default is 10001:10001. On Linux you can instead run as your own account:
#   REMEDIA_UID=1000
#   REMEDIA_GID=1000
REMEDIA_UID=10001
REMEDIA_GID=10001

# Host port published on 127.0.0.1 (the container always listens on 8787).
# REMEDIA_PORT=8787

# Host directory mounted read-only at /media by compose.media.yaml (optional).
# REMEDIA_MEDIA_DIR=/srv/media
