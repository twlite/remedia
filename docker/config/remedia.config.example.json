{
  "$schema": "https://remedia.twlite.dev/schemas/remedia.config.schema.json",
  "listen": "0.0.0.0:8787",
  "users": [
    {
      "username": "media-bot",
      "password": "env('REMEDIA_RPC_PASSWORD')"
    }
  ],
  "limits": {
    "maxConnections": 32,
    "maxClientSessions": 32,
    "maxTotalPlayers": 64
  },
  "media": {
    "allowedFileRoots": ["/media"],
    "allowHttp": false
  }
}
