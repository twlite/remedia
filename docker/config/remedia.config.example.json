{
  "$schema": "https://twlite.github.io/remedia/schemas/remedia.config.schema.json",
  "bind": {
    "host": "0.0.0.0",
    "port": 8787
  },
  "users": [
    {
      "username": "media-bot",
      "password": "env('REMEDIA_RPC_PASSWORD')"
    }
  ],
  "sessionResumptionTimeoutSeconds": 60,
  "limits": {
    "maxConnections": 32,
    "maxClientSessions": 32,
    "maxTotalPlayers": 64,
    "maxPlayersPerClient": 16,
    "maxMessageBytes": 65536,
    "requestTimeoutMs": 30000,
    "maxInFlightRequests": 16,
    "maxRequestsPerSecond": 60,
    "eventBuffer": 128
  },
  "media": {
    "allowedFileRoots": ["/media"],
    "allowedUrlHosts": [],
    "allowHttp": false,
    "allowHttps": true,
    "blockPrivateNetworks": true
  },
  "pluginHosts": [],
  "observability": {
    "console": true
  }
}
