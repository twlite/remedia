{
  "name": "remedia",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "lint": "oxlint . --deny-warnings",
    "lint:fix": "oxlint . --fix --deny-warnings",
    "format": "oxfmt .",
    "format:check": "oxfmt . --check",
    "test:release": "node --test .github/scripts/release.test.mjs .github/scripts/github-release.test.mjs .github/scripts/release-authorization.test.mjs .github/scripts/installer.test.mjs .github/scripts/normalize-macos-addon.test.mjs .github/scripts/docker-tags.test.mjs",
    "typecheck": "pnpm --recursive --if-present run typecheck && pnpm docs:typecheck",
    "check": "pnpm lint && pnpm typecheck && pnpm --filter @remedia/config schema:check && pnpm --filter @remedia/config test && pnpm format:check && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace && pnpm --filter @remedia/node test && pnpm --filter @remedia/client test && pnpm --filter @remedia/plugin-host test && pnpm --filter discord-app test",
    "test:ci": "node --test .github/scripts/ci-changes.test.mjs",
    "docs:api": "node scripts/docs/generate.ts",
    "docs:typecheck": "tsc -p scripts/docs/tsconfig.json",
    "docs:test": "node --test scripts/docs/tests/*.test.ts",
    "docs:verify-export": "node scripts/docs/verify-export.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "typedoc": "0.28.20",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.16.1"
}
