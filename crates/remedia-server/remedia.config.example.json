{
  "bind": {
    "host": "127.0.0.1",
    "port": 8787
  },
  "users": [
    {
      "username": "media-bot",
      "password": "env('REMEDIA_RPC_PASSWORD')"
    }
  ],
  "sessionResumptionTimeoutSeconds": 60,
  "limits": {
    "maxConnections": 128,
    "maxClientSessions": 128,
    "maxTotalPlayers": 256,
    "maxPlayersPerClient": 16,
    "maxMessageBytes": 65536,
    "requestTimeoutMs": 30000,
    "maxInFlightRequests": 16,
    "maxRequestsPerSecond": 60,
    "eventBuffer": 128
  },
  "media": {
    "allowedFileRoots": ["./media"],
    "allowedUrlHosts": ["media.example.com"],
    "allowHttp": true,
    "allowHttps": true,
    "blockPrivateNetworks": true
  },
  "observability": {
    "console": true
  }
}
