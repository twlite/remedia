{
  "name": "@remedia/config",
  "version": "0.1.0",
  "description": "Runtime configuration validation and JSON Schema for Remedia server",
  "license": "MIT",
  "files": [
    "dist",
    "remedia.config.schema.json",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema.json": "./remedia.config.schema.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "schema": "node scripts/schema.mjs",
    "schema:check": "node scripts/schema.mjs --check",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "oxfmt": "0.75.0",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
