{
  "name": "@remedia/client",
  "version": "0.1.0",
  "description": "Hybrid embedded and remote client SDK for Remedia",
  "license": "MIT",
  "author": "Twilight <hello@twlite.dev>",
  "repository": "https://github.com/twlite/remedia.git",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --exclude tests/hybrid.test.ts --exclude tests/server-integration.test.ts --exclude tests/plugin-host-integration.test.ts",
    "test:server": "pnpm --filter @remedia/plugin-host build && vitest run tests/server-integration.test.ts tests/plugin-host-integration.test.ts",
    "test:plugin-host": "pnpm --filter @remedia/plugin-host build && vitest run tests/plugin-host-integration.test.ts",
    "test:hybrid": "vitest run tests/hybrid.test.ts",
    "test:watch": "vitest",
    "typecheck": "pnpm --filter @remedia/plugin-host build && tsc -p tsconfig.test.json --noEmit",
    "prepack": "node ../../.github/scripts/stage-licenses.mjs"
  },
  "dependencies": {
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@remedia/plugin-host": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "@remedia/node": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@remedia/node": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
