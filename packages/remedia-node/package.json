{
  "name": "@remedia/node",
  "version": "0.0.0",
  "private": true,
  "description": "Native Node.js playback and Discord voice bindings for Remedia",
  "author": "Twilight <hello@twlite.dev>",
  "repository": "https://github.com/twlite/remedia.git",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:native && pnpm run build:types",
    "build:native": "napi build --platform --esm --js native.js --dts native.d.ts --release",
    "build:native:debug": "napi build --platform --esm --js native.js --dts native.d.ts",
    "build:types": "tsc -p tsconfig.json",
    "build:debug": "pnpm run build:native:debug && pnpm run build:types",
    "test": "pnpm run build:debug && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.9",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "napi": {
    "binaryName": "node",
    "packageName": "@remedia/node"
  }
}
