{
  "name": "@remedia/node",
  "version": "0.1.0",
  "description": "Native Node.js playback and Discord voice bindings for Remedia",
  "license": "MIT",
  "author": "Twilight <hello@twlite.dev>",
  "repository": "https://github.com/twlite/remedia.git",
  "files": [
    "dist",
    "native.js",
    "native.d.ts",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "THIRD_PARTY_LICENSES.txt"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "pnpm run build:native && pnpm run build:types",
    "build:native": "napi build --platform --esm --js native.js --dts native.d.ts --release && pnpm run normalize:native && pnpm run build:bootstrap",
    "build:native:debug": "napi build --platform --esm --js native.js --dts native.d.ts && pnpm run normalize:native && pnpm run build:bootstrap:debug",
    "build:bootstrap": "node ../../.github/scripts/build-bootstrap.mjs",
    "build:bootstrap:debug": "node ../../.github/scripts/build-bootstrap.mjs --debug",
    "normalize:native": "node ../../.github/scripts/normalize-macos-addon.mjs",
    "build:types": "tsc -p tsconfig.json",
    "build:debug": "pnpm run build:native:debug && pnpm run build:types",
    "test": "pnpm run build:native:debug && pnpm run build:types && pnpm run test:bindings",
    "test:bindings": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "prepack": "node ../../.github/scripts/stage-licenses.mjs"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.10.9",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  },
  "napi": {
    "binaryName": "node",
    "npmClient": "pnpm",
    "packageName": "@remedia/node",
    "rootPublisher": "pnpm",
    "targets": [
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "armv7-unknown-linux-gnueabihf",
      "i686-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "aarch64-linux-android",
      "armv7-linux-androideabi",
      "x86_64-unknown-freebsd"
    ]
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
