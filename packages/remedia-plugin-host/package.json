      "types": "./node.d.ts",
      "import": "./node.js"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "typecheck": "node --check index.js && node --check node.js"
  }
}
