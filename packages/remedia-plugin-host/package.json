{
  "name": "@remedia/plugin-host",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Generic plugin operation host with direct requests and optional HTTP protocol",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js"
    },
